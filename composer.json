{
    "name": "eightbitsnl/policy-and-permission-generator",
    "description": "Policy and Permission Generator",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Eightbitsnl\\PolicyAndPermissionGenerator\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Loek Wetzels",
            "email": "loek.wetzels@gmail.com",
            "homepage": "https://eightbits.nl",
            "role": "Developer"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1",
        "illuminate/auth": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/cache": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "spatie/laravel-permission": "^5.0|^6.0|^7.0|^8.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Eightbitsnl\\PolicyAndPermissionGenerator\\PolicyAndPermissionGeneratorServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
